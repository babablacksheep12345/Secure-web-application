# Flask
FLASK_ENV=development
# RENDER=true          # Set automatically on Render free tier
SECRET_KEY=change-this-to-a-long-random-secret-key
JWT_SECRET_KEY=change-this-jwt-secret-key-too

# Database (SQLite by default)
DATABASE_URL=sqlite:///secure_app.db

# OAuth - Google (optional, register at https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encryption key for sensitive data at rest (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=
